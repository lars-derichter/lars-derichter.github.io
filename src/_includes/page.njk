---
layout: base.njk
---
{#
  A static page: heading, optional lead, then prose on the reading measure.
  Front matter must come first in the file; see post.njk.
#}
<article class="prose">
  <header>
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1 class="ruled">{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </header>
  {{ content | safe }}
</article>
