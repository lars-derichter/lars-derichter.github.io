---
layout: base.njk
title: Avonturen in AI-Land
eleventyNavigation: false
---
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow">Lars De Richter</p>
      <h1>Avonturen in AI-Land</h1>
      <p class="lead">{{ site.description }}</p>
    </div>
    <div class="hero__mark">
      {% set size = 120 %}
      {% include "partials/mark.njk" %}
    </div>
  </div>
</section>

<div class="wrap page">

  <h2 class="ruled">Recente berichten</h2>
  {% set posts = collections.posts | head(5) %}
  {% include "partials/post-list.njk" %}

  {% if collections.posts.length > 5 %}
    <p><a href="/blog/">Alle berichten →</a></p>
  {% endif %}

  <h2 class="ruled">Onderwerpen</h2>
  <ul class="tag-cards">
    {% for tag in topics %}
      <li>
        <h3><a href="/tags/{{ tag.slug }}/">{{ tag.label }}</a></h3>
        <p>{{ tag.description }}</p>
      </li>
    {% endfor %}
  </ul>
</div>
